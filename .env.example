# Copy this file to ".env" and fill in real values. ".env" is gitignored.
# Use a least-privilege application user, NOT root (see db/migrations/000_create_app_user.sql).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pam
DB_USER=pam_app
DB_PASS=change_me

# Set to 1 only in local development to show errors. Keep 0 in production.
APP_DEBUG=0
