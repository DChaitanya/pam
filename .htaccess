# ─────────────────────────────────────────────────────────────────────────
# PAM hardening (Phase 1). Assumes Apache 2.4 + mod_php (php:8.3-apache).
# ─────────────────────────────────────────────────────────────────────────

# S6: never display PHP errors to the browser in production. Log instead.
<IfModule mod_php7.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# S7: hardened session cookies (defence in depth alongside auth_guard.php).
<IfModule mod_php7.c>
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
    php_value session.cookie_samesite "Lax"
</IfModule>
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
    php_value session.cookie_samesite "Lax"
</IfModule>

# S5: block direct web access to secrets, dumps, logs and scripts.
<FilesMatch "\.(sql|env|log|orig|sh|yml|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "(query_log|error_log|search_query_log|login_log)\.txt$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block dotfiles (.env, .git, .htaccess, .project, .buildpath, ...).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block sensitive directories entirely.
RedirectMatch 404 (?i)/(backups|db|tools|\.git)(/|$)

